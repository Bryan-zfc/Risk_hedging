       "0         17.52        17.52     0.269282"
      ]
     },
     "execution_count": 5,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "iv = implied_vol_call(\n",
    "    market_price=market_price,\n",
    "    S=S0,\n",
    "    K=K,\n",
    "    T=T,\n",
    "    r=r\n",
    ")\n",
    "\n",
    "model_price = bs_call_price(S0, K, T, r, iv)\n",
    "\n",
    "pd.DataFrame({\n",
    "    \"Market Price\": [market_price],\n",
    "    \"Model Price\": [model_price],\n",
    "    \"Implied Vol\": [iv]\n",
    "})\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "44d3ecff",
   "metadata": {},
   "outputs": [],
   "source": [
    "ivs = []\n",
    "\n",
    "for _, row in calls.iterrows():\n",
    "    try:\n",
    "        iv = implied_vol_call(\n",
    "            market_price=row[\"lastPrice\"],\n",
    "            S=S0,\n",
    "            K=row[\"strike\"],\n",
    "            T=row[\"timeToMaturity\"],\n",
    "            r=r\n",
    "        )\n",
    "        ivs.append(iv)\n",
    "    except:\n",
    "        ivs.append(np.nan)\n",
    "\n",
    "calls[\"implied_vol\"] = ivs\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "276940d2",
   "metadata": {},
   "outputs": [
    {
     "data": {
