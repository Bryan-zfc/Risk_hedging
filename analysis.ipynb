   "source": [
    "This notebook demonstrates:\n",
    "\n",
    "- Getting real market option data from Yahoo Finance\n",
    "- Pricing options using Black–Scholes\n",
    "- Computing the implied volatility\n",
    "- Studying volatility smile behaviour\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "c090acbe",
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "import os\n",
    "\n",
    "# Add project root to path\n",
    "PROJECT_ROOT = os.path.abspath(\"..\")\n",
    "if PROJECT_ROOT not in sys.path:\n",
    "    sys.path.append(PROJECT_ROOT)\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "cafea5eb",
   "metadata": {},
