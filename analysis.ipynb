       "Index(['contractSymbol', 'lastTradeDate', 'strike', 'lastPrice', 'bid', 'ask',\n",
       "       'change', 'percentChange', 'volume', 'openInterest',\n",
       "       'impliedVolatility', 'inTheMoney', 'contractSize', 'currency'],\n",
       "      dtype='object')"
      ]
     },
     "execution_count": 3,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "ticker = \"AAPL\"\n",
    "expiry = \"2026-05-15\"\n",
    "\n",
    "S0 = get_stock_price(ticker)\n",
    "calls, puts = get_option_chain(ticker, expiry)\n",
    "\n",
    "print(\"Spot price:\", S0)\n",
    "calls.head()\n",
    "calls.columns\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "c4701b17",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "(np.float64(275.0), np.float64(17.52))"
      ]
     },
     "execution_count": 4,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# Pick one call option near ATM\n",
    "option = calls.iloc[(calls[\"strike\"] - S0).abs().argmin()]\n",
    "\n",
    "K = option[\"strike\"]\n",
    "market_price = option[\"lastPrice\"]\n",
    "T = (pd.to_datetime(expiry) - pd.Timestamp.today()).days / 365.0\n",
    "r = 0.05\n",
    "\n",
    "K, market_price\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "a6c6bd64",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/html": [
       "<div>\n",
